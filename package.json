{
  "name": "outcometick",
  "version": "1.4.0",
  "description": "Strategy SDK and CLI for outcometick prediction-market backtests",
  "type": "module",
  "license": "MIT",
  "homepage": "https://outcometick.com/docs/sdk",
  "bin": {
    "ot": "./bin/ot.mjs"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "api",
    "runner",
    "cli",
    "bin",
    "index.mjs",
    "index.d.ts",
    "!**/*.test.mjs",
    "!**/*.test-d.ts"
  ],
  "scripts": {
    "test": "node --test runner/analyze/*.test.mjs runner/engine/*.test.mjs runner/harness/node/*.test.mjs cli/*.test.mjs"
  },
  "dependencies": {
    "acorn": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {
    "danfojs-node": {
      "optional": true
    },
    "mathjs": {
      "optional": true
    },
    "decimal.js": {
      "optional": true
    }
  }
}
